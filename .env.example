TELEGRAM_GROUP_ID=-1003510224043
TEST_GROUP_ID=-5270638639
TELEGRAPH_TOKEN=
DEEPSEEK_API_KEY=
MINIFLUX_URL=http://localhost:8080
MINIFLUX_API_TOKEN=
MINIFLUX_USERNAME=admin
MINIFLUX_PASSWORD=

# Feed source toggles
ENABLE_PANEWS=0
ENABLE_REPLACEMENT_FEEDS=1
ENABLE_RSSHUB_FEEDS=0
ENABLE_FORESIGHT_API=1
FORESIGHT_API_LIMIT=50
SOURCE_HISTORY_DB=data/source_history.sqlite3

# Telegram output caps. Set a value to 0 to send all items for that topic.
TELEGRAM_DEFAULT_TOPIC_LIMIT=10
TELEGRAM_LIMIT_PORTFOLIO=20
TELEGRAM_LIMIT_EXCHANGE_LISTINGS=20
TELEGRAM_LIMIT_DEAL_FLOW=12
TELEGRAM_LIMIT_RWA=12
TELEGRAM_LIMIT_STABLECOINS=10
TELEGRAM_LIMIT_DEFI=12
TELEGRAM_LIMIT_SECURITY=10
TELEGRAM_LIMIT_GOVERNANCE=8
TELEGRAM_LIMIT_INFRA=8
TELEGRAM_LIMIT_REGULATORY=12
TELEGRAM_LIMIT_MACRO=10
TELEGRAM_LIMIT_MARKET_STRUCTURE=10
TELEGRAM_LIMIT_NARRATIVES=8
TELEGRAM_LIMIT_GENERAL=6

# Use http://localhost:1200 for live/local fetches.
# Use http://rsshub:1200 when importing RSSHub routes into Miniflux in Docker Compose.
RSSHUB_URL=http://localhost:1200
RSSHUB_CACHE_EXPIRE=600
RSSHUB_UA=ForesightNews/1.0
